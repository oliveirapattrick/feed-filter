{
  "manifest_version": 3,
  "name": "Feed Filter",
  "version": "1.1",
  "description": "Filtra, baixa e transcreve posts do Instagram e TikTok",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["shared/outlier.js", "shared/filters-modal.js", "content/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["shared/outlier.js", "shared/filters-modal.js", "content/tiktok.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "http://localhost:5123/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["shared/*", "content/xhr_interceptor.js", "content/tiktok_fetch_interceptor.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
